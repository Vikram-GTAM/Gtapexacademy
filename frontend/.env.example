# Copy to .env and fill in from Supabase dashboard > Project Settings > API.
# Both values are public by design: they end up in every visitor's browser. Never put the service_role key,
# database password or Razorpay secret in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The website's address, for example https://www.example.com. Needed for the sitemap and search tags.
VITE_SITE_URL=
VITE_SUPABASE_ANON_KEY=your-anon-public-key
